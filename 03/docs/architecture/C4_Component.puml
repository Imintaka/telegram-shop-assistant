@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/release/v2.13.0/C4_Component.puml

title C3 - Component Diagram: Telegram Shop Assistant Backend

rectangle "Telegram\n<<External System>>" as telegram

rectangle "DummyJSON Products API\n<<External System>>" as productsApi

rectangle "Backend\nNode.js + Fastify" {

    rectangle "Telegram Routes\n<<Component>>\nПринимает webhook и извлекает сообщение" as telegramRoutes

    rectangle "Find Products Use Case\n<<Component>>\nОбрабатывает поисковый запрос" as findProductsUseCase

    rectangle "Products Adapter\n<<Component>>\nОбращается к DummyJSON API" as productsAdapter

    rectangle "Telegram Adapter\n<<Component>>\nОтправляет сообщения через Telegram Bot API" as telegramAdapter
}

telegram --> telegramRoutes : Webhook\nHTTPS / JSON

telegramRoutes --> findProductsUseCase : Передаёт текст сообщения

findProductsUseCase --> productsAdapter : Запрашивает товары

productsAdapter --> productsApi : HTTPS / JSON

telegramRoutes --> telegramAdapter : Передаёт ответ

telegramAdapter --> telegram : Telegram Bot API\nHTTPS / JSON

@enduml